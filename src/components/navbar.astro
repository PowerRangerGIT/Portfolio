---
const links = [
    { label: 'Inicio', href: '#hero' },
    { label: 'Sobre mí', href: '#about' },
    { label: 'Proyectos', href: '#projects' },
    { label: 'Contacto', href: '#contact' }
];
---

<nav class="neon-nav">
    <div class="nav-brand">
        <img src="/logo.png" alt="Logo personal" class="logo" width="48" height="48" />
        <div>
            <span class="brand-eyebrow">Portafolio</span>
        </div>
    </div>

    <div class="nav-links">
        {links.map((link) => (
            <a href={link.href} class="nav-link">{link.label}</a>
        ))}
    </div>

    <a class="nav-cta" href="#contact">Hablemos</a>
</nav>

<style>
    :global(body) {
        scroll-padding-top: 120px;
    }

    .neon-nav {
        position: sticky;
        top: 24px;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.75rem;
        margin: 0 auto 3rem;
        max-width: 1100px;
        border-radius: 999px;
        background: linear-gradient(120deg, rgba(7, 4, 18, 0.95), rgba(18, 7, 34, 0.85));
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow:
            0 35px 80px rgba(5, 1, 12, 0.65),
            inset 0 0 30px rgba(255, 79, 216, 0.08),
            inset 0 0 45px rgba(66, 255, 247, 0.08);
        backdrop-filter: blur(18px);
        isolation: isolate;
    }

    .neon-nav::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(120deg, rgba(66, 255, 247, 0.8), rgba(255, 79, 216, 0.8));
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0.4;
        z-index: -1;
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .logo {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 18px rgba(66, 255, 247, 0.45);
    }

    .brand-eyebrow {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--color-text-muted);
    }

    .brand-name {
        font-family: "Orbitron", var(--font-display);
        font-size: 1.05rem;
        letter-spacing: 0.12em;
        color: var(--color-text-base);
    }

    .nav-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .nav-link {
        position: relative;
        padding: 0.55rem 1.15rem;
        border-radius: 999px;
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-base);
        transition: color 0.2s ease-out;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(120deg, rgba(66, 255, 247, 0.15), rgba(255, 79, 216, 0.15));
        opacity: 0;
        transform: scale(0.85);
        transition: opacity 0.2s ease-out, transform 0.2s ease-out;
        z-index: -1;
    }

    .nav-link:hover,
    .nav-link:focus-visible {
        color: var(--color-accent-primary);
        text-shadow: var(--glow-strong);
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after {
        opacity: 1;
        transform: scale(1);
    }

    .nav-cta {
        padding: 0.65rem 1.6rem;
        border-radius: 999px;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #05010c;
        background: linear-gradient(120deg, var(--color-accent-primary), var(--color-accent-secondary));
        box-shadow: 0 0 25px rgba(66, 255, 247, 0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .nav-cta:hover {
        transform: translateY(-2px);
        box-shadow:
            0 0 25px rgba(66, 255, 247, 0.5),
            0 0 40px rgba(255, 79, 216, 0.35);
    }

    @media (max-width: 900px) {
        .neon-nav {
            flex-direction: column;
            gap: 1rem;
            border-radius: 32px;
        }

        .nav-links {
            width: 100%;
        }

        .nav-cta {
            width: 100%;
            text-align: center;
        }
    }
</style>
